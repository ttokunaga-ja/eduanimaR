# ─── Librarian サービス設定 ──────────────────────────────────────
# gRPC リスニングポート
LIBRARIAN_PORT=50051
# HTTP health/ready ポート
LIBRARIAN_HEALTH_PORT=8081

# Gemini API キー（Google AI Studio で取得）
GEMINI_API_KEY=your-gemini-api-key-here

# ─── モデル設定 ─────────────────────────────────────────────────
# Phase 1: クエリ生成・充足度評価に使用するモデル
# LIBRARIAN_MODEL 環境変数で上書き可能
LIBRARIAN_MODEL=gemini-2.0-flash-lite

# ─── LangGraph エージェント設定 ──────────────────────────────────
# 最大推論ループ数（デフォルト: 5、平均 3 回で収束する設計）
# 上限 5 回で強制終了する。LIBRARIAN_MAX_LOOPS で上書き可能。
LIBRARIAN_MAX_LOOPS=5
# 1クエリあたりの最大検索結果数（デフォルト: 10）
LIBRARIAN_MAX_RESULTS=10
# タイムアウト（ミリ秒、デフォルト: 30000）
LIBRARIAN_TIMEOUT_MS=30000

# ─── Temperature 設計方針 ────────────────────────────────────────
# クエリ生成 (build_search_queries): Temperature=0.3
#   → 多様なクエリバリエーションで検索カバレッジを向上
# 充足度評価 (evaluate_search_results): Temperature=0.0
#   → 決定論的な終了判断（ランダム性は誤判断・無限ループの原因）
# ※ Temperature は graph.py に直接記述。環境変数での変更は非推奨。

# ─── ロギング設定 ────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Phase 3 設計メモ（将来実装予定）────────────────────────────
# Phase 3 では thinking_level / thinking_budget（Gemini 2.5 系）の導入を検討:
#
# 3-A クエリ生成: thinking_level=low （多様性重視）
# 3-B 充足性検証（中間ループ）: thinking_level=low
# 3-B 充足性検証（最終ループのみ）: thinking_level=medium（偽陽性防止）
#
# LIBRARIAN_MODEL_FAST=gemini-2.5-flash
# LIBRARIAN_THINKING_PLAN=low
# LIBRARIAN_THINKING_EVALUATE=low
# LIBRARIAN_THINKING_EVALUATE_FINAL=medium
