# ─── Librarian サービス設定 ──────────────────────────────────────
# gRPC リスニングポート
LIBRARIAN_PORT=50051
# HTTP health/ready ポート
LIBRARIAN_HEALTH_PORT=8081

# Gemini API キー（Google AI Studio で取得）
GEMINI_API_KEY=your-gemini-api-key-here

# ─── ThinkingLevel別モデル設定（C要件）─────────────────────────────
#
# Professor の model パラメータに応じてLibrarianが使用するモデルが決まる:
#
# | Professor model  | thinking_level | Librarian Model              | max_loops |
# |------------------|----------------|------------------------------|-----------|
# | eduanima-flash   | flash-lite     | LIBRARIAN_MODEL_FLASH_LITE   |     3     |
# | eduanima (default)| flash         | LIBRARIAN_MODEL_FLASH        |     4     |
# | eduanima-pro     | flash          | LIBRARIAN_MODEL_FLASH        |     5     |
#
# ※ LibrarianはProレベルでもflashモデルを使用する（設計方針）

# eduanima-flash レベル用（最速・thinking_level="flash-lite"）
LIBRARIAN_MODEL_FLASH_LITE=gemini-3.1-flash-lite-preview

# eduanima / eduanima-pro レベル用（thinking_level="flash"）
LIBRARIAN_MODEL_FLASH=gemini-3-flash-preview

# ─── LangGraph エージェント設定 ──────────────────────────────────
# 最大推論ループ数のデフォルト値（constraints.max_loops未指定時のフォールバック）
# 実際のループ数はProfessorのThinkingLevelで制御される:
#   - eduanima-flash: 3, eduanima: 4, eduanima-pro: 5
LIBRARIAN_MAX_LOOPS=4

# 1クエリあたりの最大検索結果数（デフォルト: 10）
# 実際のTop-Kはループ回数に応じてProfessor側で動的に制御される（B-1: Dynamic Top-K）
LIBRARIAN_MAX_RESULTS=10

# タイムアウト（ミリ秒、デフォルト: 30000）
LIBRARIAN_TIMEOUT_MS=30000

# ─── Temperature 設計方針 ────────────────────────────────────────
# クエリ生成 (build_search_queries): Temperature=0.3
#   → 多様なクエリバリエーションで検索カバレッジを向上
# 評価・選別 (evaluate_and_triage): Temperature=0.0 + Seed=42
#   → 決定論的な終了判断（ランダム性は誤判断・無限ループの原因）
#   → 同時にuseful_chunk_idsで有用チャンクをTriaging（A-3）
# ※ Temperature は graph.py に直接記述。環境変数での変更は非推奨。

# ─── ロギング設定 ────────────────────────────────────────────────
LOG_LEVEL=INFO
