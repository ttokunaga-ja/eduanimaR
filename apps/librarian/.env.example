# ─── Librarian サービス設定 ──────────────────────────────────────
# gRPC リスニングポート
LIBRARIAN_PORT=50051
# HTTP health/ready ポート
LIBRARIAN_HEALTH_PORT=8081

# Gemini API キー（Google AI Studio で取得）
GEMINI_API_KEY=your-gemini-api-key-here

# LangGraph エージェント設定
# 最大推論ループ数（デフォルト: 3）
LIBRARIAN_MAX_LOOPS=3
# 1クエリあたりの最大検索結果数（デフォルト: 10）
LIBRARIAN_MAX_RESULTS=10
# タイムアウト（ミリ秒、デフォルト: 30000）
LIBRARIAN_TIMEOUT_MS=30000

# ロギング設定
LOG_LEVEL=INFO

# ─── モデル設定 ─────────────────────────────────────────────────
# Phase 3: Search（クエリ生成・情報充足性検証）
# 品質優先構成（デフォルト）: Flash
# コスト最適化案（将来）: 3-AのみFlash Liteに変更
#   LIBRARIAN_MODEL_SEARCH_PLAN=gemini-3.1-flash-lite-preview
#   LIBRARIAN_MODEL_SEARCH_EVALUATE=gemini-3-flash
LIBRARIAN_MODEL_SEARCH=gemini-3-flash

# ─── thinking_level 設定 ────────────────────────────────────────
# ⚠️ gemini-3-flash のデフォルトは high（未設定で高コスト・高レイテンシ）
# ⚠️ thinking_budget（旧パラメータ）は廃止。thinking_level のみを使用。
#
# 設計方針（パターン2）:
#   3-A クエリ生成: 全ループ low を維持（多様性重視）
#   3-B 充足性検証: 中間=low、最終のみ medium（偽陽性防止）
#
# 最終ループの判定基準: ループ回数ベース
#   loop_count < max_loops - 1  → LIBRARIAN_THINKING_PLAN / EVALUATE を使用
#   loop_count == max_loops - 1 → LIBRARIAN_THINKING_EVALUATE_FINAL を使用

# Phase 3-A クエリ生成（全ループ共通）
LIBRARIAN_THINKING_PLAN=low

# Phase 3-B 充足性検証（中間ループ）
LIBRARIAN_THINKING_EVALUATE=low

# Phase 3-B 充足性検証（最終ループのみ）
LIBRARIAN_THINKING_EVALUATE_FINAL=medium
