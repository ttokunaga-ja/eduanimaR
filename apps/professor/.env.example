# =============================================================
# apps/professor - 環境変数サンプル
# =============================================================
# このファイルをコピーして .env を作成してください:
#   cp .env.example .env

# ─── 実行環境 ──────────────────────────────────────────────────
APP_ENV=development
PORT=8080

# ─── PostgreSQL ────────────────────────────────────────────────
DATABASE_URL=postgres://eduanima:eduanima_password@localhost:5432/eduanima_professor?sslmode=disable

# ─── MinIO (オブジェクトストレージ) ────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=eduanima-materials

# ─── Kafka ─────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9094
KAFKA_TOPIC_INGEST=eduanima.ingest.jobs

# ─── Gemini AI ─────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Gemini モデル設定 ──────────────────────────────────────────
# OCR / チャンク分割用モデル
# ⚠️ flash モデルはレイテンシが高く pageBench タイムアウトを引き起こすため flash-lite を使用
PROFESSOR_MODEL_INGESTION=gemini-3.1-flash-lite-preview

# ─── 並列処理設定 ────────────────────────────────────────────────
# Kafka コンシューマー: 同時に処理するファイル数（デフォルト: 3）
PROFESSOR_KAFKA_WORKER_COUNT=3
# 1ファイル内の Embedding 並列数（デフォルト: 5）
PROFESSOR_EMBEDDING_CONCURRENCY=5

# ─── Librarian gRPC ────────────────────────────────────────────
LIBRARIAN_GRPC_ADDR=localhost:50051

# ─── 認証 ──────────────────────────────────────────────────────
# APP_ENV=production では必須（Firebase プロジェクト ID）
# FIREBASE_PROJECT_ID=your-firebase-project-id

# ─── OpenTelemetry（省略可） ────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=eduanima-professor

# =============================================================
# ThinkingLevel別モデル・ループ設定
#
# リクエストの model フィールドで品質レベルを指定します:
#   "eduanima-flash" → 高速・低コスト
#   "eduanima"       → 標準品質（デフォルト）
#   "eduanima-pro"   → 高精度
# =============================================================

# ─── eduanima-flash（高速モード） ───────────────────────────────
# Librarian 検索ループ上限（デフォルト: 3）
PROFESSOR_MAX_LOOPS_FAST=3
# 回答生成モデル（デフォルト: flash）
PROFESSOR_MODEL_ANSWER_FAST=gemini-3-flash-preview
# 回答生成 thinking レベル（minimal/low/medium/high）
PROFESSOR_THINKING_ANSWER_FAST=low
# Librarian に渡す thinking_level（flash-lite モデルを使用）
PROFESSOR_LIBRARIAN_THINKING_FAST=flash-lite

# ─── eduanima（標準モード） ────────────────────────────────────
# Librarian 検索ループ上限（デフォルト: 4）
PROFESSOR_MAX_LOOPS_DEFAULT=4
# 回答生成 thinking レベル
PROFESSOR_THINKING_ANSWER_DEFAULT=low
# Librarian に渡す thinking_level（flash モデルを使用）
PROFESSOR_LIBRARIAN_THINKING_DEFAULT=flash

# ─── eduanima-pro（高精度モード） ──────────────────────────────
# Librarian 検索ループ上限（デフォルト: 5）
PROFESSOR_MAX_LOOPS_PRO=5
# 回答生成モデル（デフォルト: config の PROFESSOR_MODEL_ANSWER）
# PROFESSOR_MODEL_ANSWER_PRO=gemini-3.1-pro-preview
# 回答生成 thinking レベル
PROFESSOR_THINKING_ANSWER_PRO=medium
# Librarian に渡す thinking_level（flash モデル + ThinkingLevel.LOW）
PROFESSOR_LIBRARIAN_THINKING_PRO=flash-low
