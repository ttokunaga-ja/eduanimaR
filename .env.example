# ============================================================
# eduanimaR 環境変数テンプレート
# 使い方: cp .env.example .env  →  GEMINI_API_KEY を設定
# ============================================================

# ─────────────────────────────────────────
# 必須: Gemini API Key（全サービス共通）
# https://aistudio.google.com/apikey から取得
# ─────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ─────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────
POSTGRES_USER=eduanima
POSTGRES_PASSWORD=eduanima_password
POSTGRES_DB=eduanima_professor
# ローカル接続URL（Professor用）
DATABASE_URL=postgres://eduanima:eduanima_password@localhost:5432/eduanima_professor?sslmode=disable

# ─────────────────────────────────────────
# MinIO（Phase 1: GCS代替 S3互換ストレージ）
# Phase 2でGCS本番に切り替え時は professor の OBJECT_STORAGE_BACKEND=gcs に変更
# Console UI: http://localhost:9001
# ─────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=eduanima-materials
# Professor用 MinIO 設定
MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
OBJECT_STORAGE_BACKEND=minio

# ─────────────────────────────────────────
# Kafka
# ─────────────────────────────────────────
KAFKA_BROKERS=localhost:9094
KAFKA_TOPIC_INGEST=eduanima.ingest.jobs

# ─────────────────────────────────────────
# Professor（Go バックエンド）
# ─────────────────────────────────────────
PORT=8080
LIBRARIAN_GRPC_ADDR=localhost:50051

# ─────────────────────────────────────────
# Librarian（Python 推論サービス）
# ─────────────────────────────────────────
GRPC_PORT=50051
LIBRARIAN_HEALTH_PORT=8081
# Kafka コンシューマー有効化（PDF インデックス処理ワーカー）
# ⚠️ false にするとアップロード後のインデックス処理が行われず pageBench がタイムアウトします
LIBRARIAN_KAFKA_ENABLED=true

# ─────────────────────────────────────────
# Gemini モデル設定
# ─────────────────────────────────────────

# Professor: Ingestion（OCR / Markdown変換 / チャンク分割）
# ⚠️ Ingestion専用。他フェーズに使用しないこと
# ⚠️ flash モデルはレイテンシが高く pageBench タイムアウトを引き起こすため flash-lite を使用
PROFESSOR_MODEL_INGESTION=gemini-3.1-flash-lite-preview

# Professor: 標準回答生成モデル（eduanima デフォルトレベル）
PROFESSOR_MODEL_ANSWER=gemini-3-flash-preview

# Librarian: flash-lite モデル（eduanima-flash 用 = 高速・低コスト）
LIBRARIAN_MODEL_FLASH_LITE=gemini-3.1-flash-lite-preview

# Librarian: flash モデル（eduanima / eduanima-pro 用）
LIBRARIAN_MODEL_FLASH=gemini-3-flash-preview

# ─────────────────────────────────────────
# ThinkingLevel別モデル・ループ設定
#
# リクエストの model フィールドで品質レベルを指定します:
#
#   | Level           | Librarian Model | Librarian Thinking | Answer Model | Answer Thinking | max_loops |
#   |-----------------|----------------|--------------------|--------------|-----------------|-----------|
#   | eduanima-flash  | flash-lite     | Minimal            | flash        | Low             | 3         |
#   | eduanima        | flash          | Minimal            | flash        | Low             | 4 (default)|
#   | eduanima-pro    | flash          | Low                | pro          | Medium          | 5         |
#
# Librarian Thinking:
#   "flash-lite" = flash-lite モデル（Minimal相当、eduanima-flash用）
#   "flash"      = flash モデル + ThinkingLevel.MINIMAL（eduanima用）
#   "flash-low"  = flash モデル + ThinkingLevel.LOW（eduanima-pro用）
# ─────────────────────────────────────────

# ─── eduanima-flash（高速モード） ─────────────────────────────────────
# Librarian: flash-lite モデル、Minimal thinking
PROFESSOR_LIBRARIAN_THINKING_FAST=flash-lite
# Librarian 検索ループ上限
PROFESSOR_MAX_LOOPS_FAST=3
# 回答生成モデル（flash = 通常品質を維持）
PROFESSOR_MODEL_ANSWER_FAST=gemini-3-flash-preview
# 回答生成 thinking（Low）
PROFESSOR_THINKING_ANSWER_FAST=low

# ─── eduanima（標準モード・デフォルト） ──────────────────────────────
# Librarian: flash モデル、Minimal thinking
PROFESSOR_LIBRARIAN_THINKING_DEFAULT=flash
# Librarian 検索ループ上限
PROFESSOR_MAX_LOOPS_DEFAULT=4
# 回答生成 thinking（Low）
PROFESSOR_THINKING_ANSWER_DEFAULT=low

# ─── eduanima-pro（高精度モード） ────────────────────────────────────
# Librarian: flash モデル、Low thinking（より深い推論）
PROFESSOR_LIBRARIAN_THINKING_PRO=flash-low
# Librarian 検索ループ上限
PROFESSOR_MAX_LOOPS_PRO=5
# 回答生成モデル（pro モデルを使用、未設定なら PROFESSOR_MODEL_ANSWER を利用）
# PROFESSOR_MODEL_ANSWER_PRO=gemini-3.1-pro-preview
# 回答生成 thinking（Medium）
PROFESSOR_THINKING_ANSWER_PRO=medium

# ─────────────────────────────────────────
# Professor 並列処理設定
# ─────────────────────────────────────────
# Kafka コンシューマー: 同時に処理するファイル数（Goroutine プールのサイズ）
# 増やすと複数ファイルを並列 ingestion できるが Gemini API レート制限に注意
# デフォルト: 3（3 ファイルを同時処理）
PROFESSOR_KAFKA_WORKER_COUNT=3

# 1ファイル内の Embedding 並列数（チャンクを何件同時に Embedding API へ投げるか）
# デフォルト: 5（20 チャンクを 5 並列 → 逐次比 約5倍の速度）
PROFESSOR_EMBEDDING_CONCURRENCY=5

# DB接続プール（ローカル開発向け）
# Cloud Run Production では PROFESSOR_DB_MAX_OPEN_CONNS=10 に設定すること
# （concurrency=10 × max-instances=20 = 200 並列 → Cloud SQL max_connections を超えないよう管理）
PROFESSOR_DB_MAX_OPEN_CONNS=25
PROFESSOR_DB_MAX_IDLE_CONNS=5

# ─────────────────────────────────────────
# Librarian エージェント動作制約
# ─────────────────────────────────────────
# デフォルトの最大検索ループ数（eduanima レベルに対応）
# ※ リクエスト毎の PROFESSOR_MAX_LOOPS_* で上書き可能
LIBRARIAN_MAX_LOOPS=4
LIBRARIAN_MAX_RESULTS=10
LIBRARIAN_TIMEOUT_MS=30000

# ─────────────────────────────────────────
# 共通
# ─────────────────────────────────────────
LOG_LEVEL=info
# LOG_LEVEL=debug  # デバッグ時はこちらに変更

# ─────────────────────────────────────────
# Web（Next.js）
# ─────────────────────────────────────────
API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# ─────────────────────────────────────────
# pageBench
# ─────────────────────────────────────────
# OpenAI互換 model（eduanima-flash / eduanima / eduanima-pro）
PAGEBENCH_MODEL=eduanima
