# ============================================================
# eduanimaR Phase 1 環境変数テンプレート
# 使い方: cp .env.example .env  →  GEMINI_API_KEY を設定
# ============================================================

# ─────────────────────────────────────────
# 必須: Gemini API Key（全サービス共通）
# https://aistudio.google.com/apikey から取得
# ─────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ─────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────
POSTGRES_USER=eduanima
POSTGRES_PASSWORD=eduanima_password
POSTGRES_DB=eduanima_professor
# ローカル接続URL（Professor用）
DATABASE_URL=postgres://eduanima:eduanima_password@localhost:5432/eduanima_professor?sslmode=disable

# ─────────────────────────────────────────
# MinIO（Phase 1: GCS代替 S3互換ストレージ）
# Phase 2でGCS本番に切り替え時は professor の OBJECT_STORAGE_BACKEND=gcs に変更
# Console UI: http://localhost:9001
# ─────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=eduanima-materials
# Professor用 MinIO 設定
MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
OBJECT_STORAGE_BACKEND=minio

# ─────────────────────────────────────────
# Kafka
# ─────────────────────────────────────────
KAFKA_BROKERS=localhost:9094
KAFKA_TOPIC_INGEST=eduanima.ingest.jobs

# ─────────────────────────────────────────
# Professor（Go バックエンド）
# ─────────────────────────────────────────
PORT=8080
LIBRARIAN_GRPC_ADDR=localhost:50051

# ─────────────────────────────────────────
# Professor モデル設定
# ─────────────────────────────────────────

# Phase 1: Ingestion（OCR / Markdown変換 / チャンク分割）
# バッチAPIは使用しない（リアルタイムAPI統一）
# 理由: アップロード直後の質問に対応するため即時インデックス化が必要
# 非同期処理はKafkaキューイングで維持（バッチAPIとは別概念）
# Flash Lite: $0.25/$1.50 per 1M
# ⚠️ Ingestion専用。Flash Liteをこれ以外のフェーズに使用しないこと
PROFESSOR_MODEL_INGESTION=gemini-3.1-flash-lite-preview

# Phase 2: Planning（ユーザー質問の意図分析・調査項目・停止条件生成）
# Flash: $0.50/$3.00 per 1M
# 1リクエスト1回のみ。全探索戦略の土台。精度優先。
PROFESSOR_MODEL_PLAN=gemini-3-flash-preview

# Phase 4: Answer（最終回答生成・Blob直接入力）
# MVP: Flash で開始し品質計測後 Pro 昇格を判断する
# Pro昇格条件: 数式の誤り・複数ページ統合品質不足・図表解釈ミスが報告された場合
# ⚠️ Pro採用時: thinking_level=minimal 不可（low が最低値）
PROFESSOR_MODEL_ANSWER=gemini-3-flash-preview
# professor-fast / professor-lite 指定時に適用する回答モデル
PROFESSOR_MODEL_ANSWER_FAST=gemini-3.1-flash-lite-preview
# professor-pro 指定時のみ適用される任意の上書きモデル
# 未設定なら PROFESSOR_MODEL_ANSWER をそのまま利用
PROFESSOR_MODEL_ANSWER_PRO=

# OpenAI互換 model 名ごとの最大検索ループ数（professor-fast / professor / professor-pro）
PROFESSOR_MAX_LOOPS_FAST=3
PROFESSOR_MAX_LOOPS_DEFAULT=4
PROFESSOR_MAX_LOOPS_PRO=5

# ─────────────────────────────────────────
# Librarian（Python 推論サービス）
# ─────────────────────────────────────────
GRPC_PORT=50051
LIBRARIAN_HEALTH_PORT=8081

# エージェント動作制約（config.py で LIBRARIAN_MAX_LOOPS / MAX_RESULTS / TIMEOUT_MS として読み込み）
LIBRARIAN_MAX_LOOPS=3
LIBRARIAN_MAX_RESULTS=10
LIBRARIAN_TIMEOUT_MS=30000

# ─────────────────────────────────────────
# Librarian モデル設定
# ─────────────────────────────────────────

# Phase 3: Search（クエリ生成・情報充足性検証）
# Flash統一（品質優先構成）
# コスト最適化案（将来）: 3-AのみFlash Liteに変更
#   LIBRARIAN_MODEL_SEARCH_PLAN=gemini-3.1-flash-lite-preview
#   LIBRARIAN_MODEL_SEARCH_EVALUATE=gemini-3-flash-preview
LIBRARIAN_MODEL_SEARCH=gemini-3-flash-preview

# ─────────────────────────────────────────
# thinking_level 設定
# 有効値: minimal / low / medium / high
#
# ⚠️ 各モデルのデフォルト・制約（未設定時の挙動）:
#   gemini-3.1-flash-lite-preview : デフォルト=minimal
#   gemini-3-flash-preview        : デフォルト=high（⚠️ 高コスト・高レイテンシ）
#   gemini-3.1-pro-preview        : デフォルト=high、minimal設定不可（lowが最低値）
# → 必ず全フェーズで thinking_level を明示すること
#
# ⚠️ thinking_budget（旧パラメータ）はGemini 3系で廃止。
#   thinking_level のみを使用。両者の併用は不可。
#
# SSEストリーミングへの影響:
#   minimal/low : ほぼ即座にストリーム開始
#   medium      : TTFT 1.5〜2倍程度の遅延
#   high        : 教育UIでは原則使用しない
# → low以上は「AIが思考中...」UIプレースホルダーの表示を推奨
# ─────────────────────────────────────────

# Phase 1: 定型変換タスク。Thinkingトークン不要。
# minimalはデリミタ（---CHUNK---）遵守の安定性が高い
# （thinking_levelを上げると自由記述が増えてフォーマット崩れが起きる報告あり）
PROFESSOR_THINKING_INGESTION=minimal

# Phase 2: 意図解析の精度が検索ループ全体の品質・コストに直結
PROFESSOR_THINKING_PLAN=medium

# Phase 3-A クエリ生成（全ループ共通）
# 多様なクエリ生成には低thinking_levelの方が出力の多様性が保たれる
LIBRARIAN_THINKING_PLAN=low

# Phase 3-B 充足性検証（中間ループ）
LIBRARIAN_THINKING_EVALUATE=low

# Phase 3-B 充足性検証（最終ループのみ medium に昇格）
# 理由: 偽陽性（不十分→充足と誤判定）は取り返しがつかない。最終判断のみ精度優先。
LIBRARIAN_THINKING_EVALUATE_FINAL=medium

# Phase 4: Blob直接入力でエビデンスが絞られているため low で十分
# ⚠️ medium以上はTTFT悪化リスク（1.5〜2倍の遅延）
# ⚠️ Pro使用時もこの設定でよい（Proのminimal不可は設計に影響しない）
PROFESSOR_THINKING_ANSWER=low

# OpenAI互換 model（professor-fast/professor/professor-pro）に応じた
# 回答生成 thinking_level のデフォルト設定
PROFESSOR_THINKING_ANSWER_FAST=minimal
PROFESSOR_THINKING_ANSWER_DEFAULT=low
PROFESSOR_THINKING_ANSWER_PRO=medium

# ─────────────────────────────────────────
# 共通
# ─────────────────────────────────────────
LOG_LEVEL=info
# LOG_LEVEL=debug  # デバッグ時はこちらに変更

# ─────────────────────────────────────────
# Web（Next.js）
# ─────────────────────────────────────────
API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# ─────────────────────────────────────────
# pageBench
# ─────────────────────────────────────────
# OpenAI互換 model（professor-fast / professor / professor-pro）
PAGEBENCH_MODEL=professor
