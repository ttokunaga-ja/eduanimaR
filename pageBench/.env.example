# -------------------------------------------------------
# pageBench/.env  (このファイルを .env にコピーして設定)
# -------------------------------------------------------

# ----- Gemini API（Q&A 生成・LLM-as-Judge）-----
GEMINI_API_KEY=your_gemini_api_key_here
# Q&A 生成用モデル（高速・低コスト。Professor/Librarian の FAST モデルと同じ）
GEMINI_MODEL=gemini-3.1-flash-lite-preview
# LLM-as-Judge 用モデル（高品質な採点が必要なため ACCURATE モデルを使用）
GEMINI_JUDGE_MODEL=gemini-3.1-pro-preview
GEMINI_TIMEOUT_MS=120000
GEMINI_RATE_LIMIT_SLEEP_SEC=3

# ----- Professor API（RAG 性能評価）-----
# ローカル開発環境のデフォルト
PROFESSOR_API_URL=http://localhost:8080
# Phase 1 スタブ認証ヘッダーの値（X-Dev-User: <value>）
PROFESSOR_DEV_USER=dev-user
# 教材アップロード後のインデックス完了待機秒数
PROFESSOR_INDEX_WAIT_SECS=30
