# pageBench 設定ファイル (.env)
# このファイルをコピーして .env を作成し、値を設定してください:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ─── Agent システム（RAG バックエンド）────────────────────────
# エンドポイントの例:
#   Dify:      https://api.dify.ai/v1
#   Flowise:   https://your-flowise.example.com/api/v1
#   eduanimaR: https://your-api.example.com/api/v1/subjects/{subject_id}
#
# リクエスト形式: POST {AGENT_API_BASE}/chat/completions
#   {
#     "model":    "<PAGEBENCH_MODEL>",
#     "messages": [{"role": "user", "content": "<question>"}],
#     "stream":   false
#   }
AGENT_API_BASE=https://your-agent-api/v1
AGENT_API_KEY=your-api-key-here

# ─── eduanimaR モデル（品質レベル選択）──────────────────────────
# OpenAI互換の model フィールドで品質レベルを指定します（eduanimaR 専用）。
#
#   | 値               | Librarian       | 回答モデル          | ループ | 用途                   |
#   |-----------------|-----------------|-------------------|--------|------------------------|
#   | eduanima-flash  | flash-lite      | flash (Low)       |   3    | 高速評価・コスト優先     |
#   | eduanima        | flash (Minimal) | flash (Low)       |   4    | 標準（デフォルト）       |
#   | eduanima-pro    | flash (Low)     | pro (Medium)      |   5    | 高精度評価              |
#
# 非 eduanimaR の RAG システムを使用する場合は、そのシステムのモデル名を指定してください。
PAGEBENCH_MODEL=eduanima

# ─── Gemini (Judge + Generate) ───────────────────────────────
# Gemini API キー (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIza...

# LLM-as-Judge に使用するモデル (2026年3月現在の推奨)
# 標準:   gemini-3-flash-preview         ← デフォルト
# 高精度: gemini-3.1-pro-preview
# 軽量:   gemini-3.1-flash-lite-preview  (最安)
GEMINI_JUDGE_MODEL=gemini-3-flash-preview

# QA 生成に使用するモデル
GEMINI_GENERATE_MODEL=gemini-3-flash-preview

# Thinking レベル: minimal (デフォルト) | low | medium | high
# Gemini 3 ThinkingLevel API を使用
# - minimal: ThinkingLevelMinimal — Flash 系専用 (3 Flash / 3.1 Flash-Lite)。最小コスト・最速
# - low:     ThinkingLevelLow    — 浅い推論。Pro 系の最低レベル
# - medium:  ThinkingLevelMedium — バランス型 (3.1 Pro / 3 Flash)
# - high:    ThinkingLevelHigh   — 最大推論深度・最高精度
# ⚠ Pro 系モデル (gemini-3.1-pro-preview) で minimal を指定するとAPIエラーになります
GEMINI_THINKING_LEVEL=minimal

# Judge/Generate の API レート制限対策スリープ (ミリ秒)
GEMINI_RATE_LIMIT_SLEEP_MS=3000

# ─── 実行対象ドメイン ─────────────────────────────────────────
# generate / eval / report で --domain フラグを省略した際に使用されるドメイン一覧
# カンマ区切りで複数指定可能（前後のスペースは無視される）
# 例: PAGEBENCH_TARGET_DOMAINS=domains/01_academic_papers,domains/02_financial_results,domains/03_government_policy
PAGEBENCH_TARGET_DOMAINS=

# ─── QA 動的生成設定 ──────────────────────────────────────────
# PAGEBENCH_QA_DENSITY が設定されている場合、各 PDF のページ数から QA 件数を動的に計算します。
# 計算式: QA件数 = clamp( round(pages × density), qa_min, qa_max )
#
# 設定例（density=0.5 の場合）:
#   6p  → round(3.0)  = 3  (min補正)
#   10p → round(5.0)  = 5
#   13p → round(6.5)  = 7
#   20p → round(10.0) = 10
#   26p → round(13.0) = 13
#   54p → round(27.0) = 20 (max補正)
#
# PAGEBENCH_QA_DENSITY を未設定にすると、--qa-per-doc フラグの固定値を使用します。
PAGEBENCH_QA_MIN=3        # 最低 QA 件数（デフォルト: 3）
PAGEBENCH_QA_MAX=20       # 最大 QA 件数（デフォルト: 20）
PAGEBENCH_QA_DENSITY=0.5  # 1ページあたりの QA 件数（未設定 = 動的計算無効）

# ─── フェーズ実行制御 ─────────────────────────────────────────
# 各フェーズを実行するかどうかを true / false で指定します。
# 省略時はすべて true（全フェーズ実行）。
#
# PAGEBENCH_EXECUTE_REGISTRY:
#   true  → generate コマンド実行時に source/ をスキャンして 0a_registry.csv を生成
#   false → 既存の 0a_registry.csv を使用（0a の再生成をスキップ）
#
# PAGEBENCH_EXECUTE_QA:
#   true  → generate コマンド実行時に Gemini で 0b_qa_pairs.csv を生成
#   false → QA ペア生成をスキップ（既存の 0b_qa_pairs.csv を維持）
#
# PAGEBENCH_EXECUTE_EVALUATION_PREPARATION:
#   true  → prepare コマンド実行時に source/ の PDF を POST {AGENT_API_BASE}/files でアップロードし
#            インデックス完了を待機して {domainDir}/.pagebench_prep.json に file_ids を保存
#   false → アップロードをスキップ（既存の .pagebench_prep.json を使用）
#
# PAGEBENCH_EXECUTE_EVALUATION:
#   true  → eval コマンド実行時に Agent へクエリして 0c_evaluation.csv + 0d_evaluation_report.md を生成
#   false → 評価をスキップ（既存の 0c/0d を維持）
#
# 使用例:
#   0a のみ再生成:       EXECUTE_REGISTRY=true,  EXECUTE_QA=false, EXECUTE_EVALUATION_PREPARATION=false, EXECUTE_EVALUATION=false
#   0b のみ再生成:       EXECUTE_REGISTRY=false, EXECUTE_QA=true,  EXECUTE_EVALUATION_PREPARATION=false, EXECUTE_EVALUATION=false
#   アップロードのみ:    EXECUTE_REGISTRY=false, EXECUTE_QA=false, EXECUTE_EVALUATION_PREPARATION=true,  EXECUTE_EVALUATION=false
#   0c/0d のみ再生成:    EXECUTE_REGISTRY=false, EXECUTE_QA=false, EXECUTE_EVALUATION_PREPARATION=false, EXECUTE_EVALUATION=true
PAGEBENCH_EXECUTE_REGISTRY=true
PAGEBENCH_EXECUTE_QA=true
PAGEBENCH_EXECUTE_EVALUATION_PREPARATION=true
PAGEBENCH_EXECUTE_EVALUATION=true

# ─── Evaluation Preparation（RAG インデックス作成）────────────────
# pagebench prepare コマンドで使用する設定。
# OpenAI Files API 互換: POST {AGENT_API_BASE}/files + GET {AGENT_API_BASE}/files/{id}
#
# POST /files の purpose フィールド
# OpenAI互換RAG: "assistants" (デフォルト) / Dify系: "rag-index" / 独自RAG: 任意の文字列
# ポーリング不要（即時インデックス）の RAG では "-" を指定すると待機をスキップ
AGENT_UPLOAD_PURPOSE=assistants

# GET /files/{id} の status フィールドでインデックス完了とみなす値
# OpenAI互換: "processed" (デフォルト) / Dify系: "ready" / 独自RAG: 要確認
AGENT_FILE_STATUS_READY=processed

# インデックス完了待機タイムアウト（秒）。0 = 無制限
AGENT_INDEX_TIMEOUT_SECS=300

# インデックス状態ポーリング間隔（秒）
AGENT_INDEX_POLL_INTERVAL_SECS=5
