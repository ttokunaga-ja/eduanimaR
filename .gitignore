# Root .gitignore for the eduanimaR monorepo

# ---------------------------------
# OS / editors
# ---------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
.cline/
*.swp

# ---------------------------------
# Node / frontend
# ---------------------------------
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
.nyc_output/
.vitest/
.cache/
.parcel-cache/
.turbo/
.vercel/

# ---------------------------------
# Python
# ---------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
.pyo
.Python
.venv/
venv/
env/
*.egg-info/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------
# Go
# ---------------------------------
bin/
*.exe
*.out

# ---------------------------------
# Logs / databases / temp
# ---------------------------------
*.log
logs/
*.log.*
*.sqlite3
tmp/
Tmp/
tmp*/
*.tmp

# ---------------------------------
# Environment / secrets
# ---------------------------------
.env
.env.local
.env.*.local
.env.*
*.pem
*.key
id_rsa

# ---------------------------------
# Generated / vendor / archives
# ---------------------------------
*.tgz
*.zip
*.tar

# Project-specific
eduanimaR_Professor/tmp/

# Local setup cache
.setup_state.json

# Generated PDFs
**/source_pdfs/
!**/source_pdfs/.gitkeep

# Keep examples and generated client exceptions in subprojects
!**/.env.example
!.env.example

# End

